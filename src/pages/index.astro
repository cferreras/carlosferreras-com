---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { contact, experience, projects, moreProjects, education, skills } from '../data/cv';

// El botón de descarga aparece solo cuando existe public/cv.pdf.
const cv = existsSync(join(process.cwd(), 'public', 'cv.pdf')) ? '/cv.pdf' : undefined;
---

<Base
  title="Carlos Ferreras — Desarrollador frontend"
  description="Desarrollador frontend en Oviedo. Busco un puesto junior. Experiencia, proyectos y contacto."
>
  <section class="hero">
    <span class="badge"><span class="dot" aria-hidden="true"></span>Disponible para trabajar</span>
    <h1>Hola, soy Carlos.</h1>
    <p class="lead">
      Desarrollador frontend en Oviedo. Hago interfaces con <strong
        >React, Next.js, Astro y Tailwind CSS</strong
      > y llevo mis proyectos de principio a fin, también el despliegue. Busco un puesto junior en
      Oviedo, León o en remoto/híbrido, en un equipo donde revisen mi código y pueda aportar desde el
      principio.
    </p>
    <div class="actions">
      <a class="pill primary" href={`mailto:${contact.email}`}><Icon name="mail" />Escríbeme</a>
      <a class="pill" href={contact.linkedin} target="_blank" rel="noopener noreferrer"
        ><Icon name="external" />LinkedIn</a
      >
      <a class="pill" href={contact.github} target="_blank" rel="noopener noreferrer"
        ><Icon name="external" />GitHub</a
      >
      {cv && <a class="pill" href={cv} download><Icon name="download" />Descargar CV</a>}
    </div>
  </section>

  <section id="experiencia">
    <h2>Experiencia</h2>
    <ol class="timeline">
      {
        experience.map((job) => (
          <li class:list={['job', { current: job.current }]}>
            <div class="head">
              <span class="label">{job.date}</span>
              <h3>{job.title}</h3>
              <span class="where">{job.where}</span>
            </div>
            <p class="dim">{job.description}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="proyectos">
    <h2>Proyectos</h2>
    <div class="projects">
      {
        projects.map((p) => (
          <article class="project">
            <div class="head">
              <span class="label">{p.meta}</span>
              <h3>
                <a href={p.site?.url ?? p.code} target="_blank" rel="noopener noreferrer">
                  {p.title}
                </a>
              </h3>
            </div>
            <p class="dim">{p.description}</p>
            <ul class="tags">
              {p.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
            <div class="links">
              {p.site && (
                <a href={p.site.url} target="_blank" rel="noopener noreferrer">
                  {p.site.label}
                  <Icon name="external" />
                </a>
              )}
              {p.code && (
                <a href={p.code} target="_blank" rel="noopener noreferrer">
                  Código
                  <Icon name="external" />
                </a>
              )}
            </div>
          </article>
        ))
      }

      <div class="more">
        <span class="label">Más cosas en GitHub</span>
        {
          moreProjects.map((p) => (
            <a href={p.url} target="_blank" rel="noopener noreferrer">
              <span class="more-title">
                {p.title}
                <Icon name="external" />
              </span>
              <span class="more-text">{p.description}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section id="formacion">
    <h2>Formación y habilidades</h2>
    <div class="studies">
      {
        education.map((e) => (
          <div class="study">
            <span class="label">{e.year}</span>
            <div>
              <span class="study-title">{e.title}</span>
              <span class="where">{e.school}</span>
            </div>
          </div>
        ))
      }
    </div>
    <div class="skills">
      <div>
        <span class="label">Lo que más uso</span>
        <ul class="tags strong">
          {skills.main.map((t) => <li>{t}</li>)}
        </ul>
      </div>
      <div>
        <span class="label">También he trabajado con</span>
        <ul class="tags">
          {skills.also.map((t) => <li>{t}</li>)}
        </ul>
      </div>
      <div>
        <span class="label">Despliegue</span>
        <ul class="tags">
          {skills.deploy.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="contacto">
    <h2>Contacto</h2>
    <div class="contact">
      <p class="dim">Si tienes un puesto junior o quieres comentarme algo, escríbeme.</p>
      <a class="mail" href={`mailto:${contact.email}`}>{contact.email}</a>
    </div>
  </section>
</Base>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  section + section {
    margin-top: clamp(3.5rem, 8vw, 5rem);
  }

  h1,
  h2,
  h3 {
    margin: 0;
    font-weight: 600;
  }

  h2 {
    font-size: 1.25rem;
    line-height: 1.3;
  }

  h3 {
    font-size: 1.125rem;
    line-height: 1.35;
  }

  p {
    margin: 0;
    text-wrap: pretty;
  }

  strong {
    font-weight: 600;
    color: var(--text);
  }

  .dim {
    color: var(--text-dim);
    line-height: 1.7;
  }

  .label {
    font-size: 0.875rem;
    color: var(--text-dim);
  }

  .where {
    display: block;
    line-height: 1.6;
    color: var(--text-dim);
  }

  a {
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  /* --- Presentación ------------------------------------------------ */

  .hero {
    align-items: flex-start;
    gap: 0;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-dim);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--accent);
  }

  h1 {
    margin-top: 1.25rem;
    font-size: clamp(2rem, 1.5rem + 2.4vw, 2.75rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .lead {
    margin-top: 1.25rem;
    max-width: 34rem;
    line-height: 1.7;
    color: var(--text-dim);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.75rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9375rem;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .pill:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .pill.primary {
    padding: 9px 16px;
    border-radius: 6px;
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
  }

  .pill.primary:hover {
    background: var(--text);
    color: var(--bg);
  }

  /* --- Tecnologías: texto plano separado por puntos ---------------- */

  .tags {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-dim);
  }

  .tags li + li::before {
    content: '·';
    content: '·' / '';
    margin-inline: 0.5rem;
  }

  .tags.strong {
    color: var(--text);
  }

  /* --- Experiencia ------------------------------------------------- */

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .job {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  /* --- Proyectos --------------------------------------------------- */

  .projects {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .project {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .project h3 a:hover {
    color: var(--accent);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.25rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.9375rem;
  }

  .links a:hover {
    color: var(--accent);
  }

  .more {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .more a {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .more-title {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 600;
  }

  .more-text {
    line-height: 1.6;
    color: var(--text-dim);
    text-wrap: pretty;
  }

  .more a:hover .more-title {
    color: var(--accent);
  }

  /* --- Formación y habilidades ------------------------------------- */

  .studies,
  .skills {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .study {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0 1.25rem;
    align-items: baseline;
  }

  .study-title {
    display: block;
    font-weight: 600;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .skills > div {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  /* --- Contacto ---------------------------------------------------- */

  .contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .mail {
    font-size: 1.25rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .mail:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  @media (max-width: 40rem) {
    .study {
      grid-template-columns: 2.75rem minmax(0, 1fr);
    }
  }
</style>
