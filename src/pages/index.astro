---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { contact, experience, projects, moreProjects, education, skills } from '../data/cv';

// El botón de descarga aparece solo cuando existe public/cv.pdf.
const cv = existsSync(join(process.cwd(), 'public', 'cv.pdf')) ? '/cv.pdf' : undefined;
---

<Base
  title="Carlos Ferreras — Desarrollador frontend"
  description="Desarrollador frontend en Oviedo. Busco un puesto junior. Experiencia, proyectos y contacto."
>
  <section class="hero">
    <span class="badge"><span class="dot" aria-hidden="true"></span>Disponible para trabajar</span>
    <h1>Hola, soy Carlos.</h1>
    <p class="lead">
      Desarrollador frontend en Oviedo. Hago interfaces con <strong
        >React, Next.js, Astro y Tailwind CSS</strong
      > y mantengo varios proyectos propios con usuarios reales. Busco un puesto junior en un equipo
      donde aprender y aportar desde el primer día.
    </p>
    <div class="actions">
      <a class="pill primary" href={`mailto:${contact.email}`}><Icon name="mail" />Escríbeme</a>
      <a class="pill" href={contact.linkedin} target="_blank" rel="noopener noreferrer"
        ><Icon name="external" />LinkedIn</a
      >
      <a class="pill" href={contact.github} target="_blank" rel="noopener noreferrer"
        ><Icon name="external" />GitHub</a
      >
      {cv && <a class="pill" href={cv} download><Icon name="download" />Descargar CV</a>}
    </div>
  </section>

  <section id="experiencia">
    <h2>Experiencia</h2>
    <ol class="timeline">
      {
        experience.map((job) => (
          <li class:list={['job', { current: job.current }]}>
            <div class="head">
              <span class="label">{job.date}</span>
              <h3>{job.title}</h3>
              <span class="where">{job.where}</span>
            </div>
            <p class="dim">{job.description}</p>
            <ul class="tags">
              {job.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="proyectos">
    <h2>Proyectos</h2>
    <div class="projects">
      {
        projects.map((p) => (
          <article class="project">
            <div class="head">
              <span class="label">{p.meta}</span>
              <h3>
                <a href={p.site?.url ?? p.code} target="_blank" rel="noopener noreferrer">
                  {p.title}
                </a>
              </h3>
            </div>
            <p class="dim">{p.description}</p>
            <ul class="tags">
              {p.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
            <div class="links">
              {p.site && (
                <a href={p.site.url} target="_blank" rel="noopener noreferrer">
                  {p.site.label}
                  <Icon name="external" />
                </a>
              )}
              {p.code && (
                <a href={p.code} target="_blank" rel="noopener noreferrer">
                  Código
                  <Icon name="external" />
                </a>
              )}
            </div>
          </article>
        ))
      }

      <div class="more">
        <span class="label">Más cosas en GitHub</span>
        {
          moreProjects.map((p) => (
            <a href={p.url} target="_blank" rel="noopener noreferrer">
              <span class="more-title">
                {p.title}
                <Icon name="external" />
              </span>
              <span class="more-text">{p.description}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section id="formacion">
    <h2>Formación y habilidades</h2>
    <div class="studies">
      {
        education.map((e) => (
          <div class="study">
            <span class="label">{e.year}</span>
            <div>
              <span class="study-title">{e.title}</span>
              <span class="where">{e.school}</span>
            </div>
          </div>
        ))
      }
    </div>
    <div class="skills">
      <div>
        <span class="label">Lo que más uso</span>
        <ul class="tags strong">
          {skills.main.map((t) => <li>{t}</li>)}
        </ul>
      </div>
      <div>
        <span class="label">También he trabajado con</span>
        <ul class="tags">
          {skills.also.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="sobre-mi">
    <h2>Sobre mí</h2>
    <div class="about">
      <p>
        Soy Carlos, de Oviedo. Estudié los ciclos de DAM y DAW, y después trabajé en <strong
          >TeamEQ</strong
        >, en Gijón, haciendo componentes para su producto.
      </p>
      <p>
        Desde 2022 no he trabajado para una empresa, pero no he dejado de programar. Llevo años
        montando servidores de Minecraft con su comunidad, y eso me ha obligado a aprender lo que no
        sale en un tutorial: <strong
          >desplegar, hacer copias de seguridad y arreglar las cosas cuando se caen</strong
        >.
      </p>
      <p>
        Ahora busco un puesto junior. Me gustaría entrar en un equipo donde revisen mi código y me
        digan qué mejorar, y aportar en frontend desde el principio. Si crees que puedo encajar, me
        encantará hablar contigo.
      </p>
    </div>
  </section>

  <section id="contacto">
    <h2>Contacto</h2>
    <div class="contact">
      <p class="dim">Si tienes un puesto junior o quieres comentarme algo, escríbeme.</p>
      <a class="mail" href={`mailto:${contact.email}`}>{contact.email}</a>
      <div class="links">
        <a href={contact.linkedin} target="_blank" rel="noopener noreferrer"
          >LinkedIn<Icon name="external" /></a
        >
        <a href={contact.github} target="_blank" rel="noopener noreferrer"
          >GitHub<Icon name="external" /></a
        >
        {
          cv && (
            <a href={cv} download>
              Descargar CV
              <Icon name="download" />
            </a>
          )
        }
      </div>
    </div>
  </section>
</Base>

<style>
  /* Las secciones van separadas por el mismo aire; cada una apila su
     título y su contenido con el mismo hueco. */
  section {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  section + section {
    margin-top: clamp(5.5rem, 12vw, 7.5rem);
  }

  h2 {
    margin: 0;
    font-family: var(--font-pixel);
    font-size: 1.45rem;
    font-weight: 400;
    line-height: 1.3;
  }

  h3 {
    margin: 0;
    font-weight: 400;
  }

  p {
    margin: 0;
    text-wrap: pretty;
  }

  strong {
    font-weight: 600;
    color: var(--text);
  }

  .dim {
    color: var(--text-dim);
    line-height: 1.7;
  }

  .label {
    font-family: var(--font-pixel);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--text-dim);
  }

  .where {
    display: block;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-dim);
  }

  a {
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  /* --- Presentación ------------------------------------------------ */

  .hero {
    align-items: flex-start;
    gap: 0;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 5px 13px 5px 11px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-soft);
    font-family: var(--font-pixel);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  h1 {
    margin: 1.75rem 0 0;
    font-family: var(--font-pixel);
    font-size: clamp(2.15rem, 1.5rem + 2.8vw, 3.4rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .lead {
    margin-top: 1.5rem;
    max-width: 34rem;
    line-height: 1.7;
    color: var(--text-dim);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 9px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-pixel);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .pill:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
  }

  .pill.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  .pill.primary:hover {
    border-color: var(--text);
    background: var(--text);
  }

  /* --- Etiquetas de tecnologías ------------------------------------ */

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    line-height: 1.5;
    color: var(--text-dim);
  }

  .tags.strong li {
    background: var(--bg-soft);
    color: var(--text);
  }

  /* --- Experiencia ------------------------------------------------- */

  .timeline {
    --pad: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin: 0 0 0 4px;
    padding: 0 0 0 var(--pad);
    list-style: none;
    border-left: 1px solid var(--line);
  }

  .job {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  /* El punto se centra sobre la línea de tiempo. */
  .job::before {
    content: '';
    position: absolute;
    top: 7px;
    left: calc(-1 * var(--pad) - 5px);
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1.5px var(--text-dim);
  }

  .job.current::before {
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .job h3 {
    font-family: var(--font-pixel);
    font-size: 1.375rem;
    line-height: 1.3;
    text-wrap: balance;
  }

  /* --- Proyectos --------------------------------------------------- */

  .projects {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .project {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .project .head {
    gap: 0.375rem;
  }

  .project h3 a {
    font-family: var(--font-pixel);
    font-size: clamp(1.45rem, 1.2rem + 1vw, 1.85rem);
    line-height: 1.25;
    text-wrap: balance;
  }

  .project h3 a:hover {
    color: var(--accent);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.375rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-pixel);
    font-size: 0.875rem;
  }

  .links a:hover {
    color: var(--accent);
  }

  .more {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--line);
  }

  .more a {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .more-title {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-pixel);
    font-size: 1rem;
    line-height: 1.5;
  }

  .more-text {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-dim);
    text-wrap: pretty;
  }

  .more a:hover .more-title {
    color: var(--accent);
  }

  /* --- Formación y habilidades ------------------------------------- */

  .studies,
  .skills {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .study {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0 1.25rem;
    align-items: baseline;
  }

  .study-title {
    display: block;
    font-weight: 600;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .skills > div {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* --- Sobre mí y contacto ----------------------------------------- */

  .about {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .mail {
    font-family: var(--font-pixel);
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.85rem);
    line-height: 1.25;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .mail:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  @media (max-width: 40rem) {
    .timeline {
      --pad: 1.375rem;
    }

    .study {
      grid-template-columns: 2.75rem minmax(0, 1fr);
    }
  }
</style>
