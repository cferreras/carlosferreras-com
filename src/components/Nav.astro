---
const sections = [
  { id: 'experiencia', label: 'Experiencia' },
  { id: 'proyectos', label: 'Proyectos' },
  { id: 'contacto', label: 'Contacto' },
];

const path = Astro.url.pathname;
const inBlog = path.startsWith('/blog');
---

<header class="site-header">
  <nav aria-label="Principal">
    <a class="home" href="/" aria-current={path === '/' ? 'page' : undefined}>Carlos Ferreras</a>
    <div class="links">
      {sections.map(({ id, label }) => <a href={`/#${id}`}>{label}</a>)}
      <a href="/blog/" aria-current={inBlog ? 'page' : undefined}>Blog</a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    width: 100%;
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin-inline: auto;
    padding: 1.5rem var(--gutter) 0;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
  }

  .home {
    font-weight: 600;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .links a {
    font-size: 0.9375rem;
    color: var(--text-dim);
    transition: color 0.2s ease;
  }

  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--accent);
  }
</style>
