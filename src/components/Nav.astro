---
const sections = [
  { id: 'experiencia', label: 'Experiencia' },
  { id: 'proyectos', label: 'Proyectos' },
  { id: 'contacto', label: 'Contacto' },
];

const path = Astro.url.pathname;
const inBlog = path.startsWith('/blog');
---

<header class="nav-wrap">
  <nav aria-label="Principal">
    <a class="home" href="/" aria-current={path === '/' ? 'page' : undefined}>Carlos</a>
    <span class="sep" aria-hidden="true"></span>
    {sections.map(({ id, label }) => <a href={`/#${id}`} data-section={id}>{label}</a>)}
    <span class="sep blog-only" aria-hidden="true"></span>
    <a
      class:list={['blog-only', { 'is-active': inBlog }]}
      href="/blog/"
      aria-current={inBlog ? 'page' : undefined}>Blog</a
    >
  </nav>
</header>

<script is:inline>
  // Marca en el menú la sección de la portada que se está leyendo. Espera al
  // DOM completo: el menú se pinta antes que las secciones.
  document.addEventListener('DOMContentLoaded', () => {
    const links = [...document.querySelectorAll('.nav-wrap a[data-section]')];
    const sections = links.map((a) => document.getElementById(a.dataset.section)).filter(Boolean);
    if (!sections.length) return;

    const setActive = (id) =>
      links.forEach((a) => a.classList.toggle('is-active', a.dataset.section === id));

    const observer = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && setActive(e.target.id)),
      { rootMargin: '-40% 0px -55% 0px' },
    );
    sections.forEach((s) => observer.observe(s));
    addEventListener('scroll', () => scrollY < 200 && setActive(null), { passive: true });
  });
</script>

<style>
  .nav-wrap {
    position: fixed;
    inset: 1rem 0 auto;
    z-index: 10;
    display: flex;
    justify-content: center;
    padding-inline: 0.75rem;
    pointer-events: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2px;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 5px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-soft);
    box-shadow: var(--shadow);
    pointer-events: auto;
  }

  nav::-webkit-scrollbar {
    display: none;
  }

  a {
    flex-shrink: 0;
    padding: 6px 14px;
    border-radius: 999px;
    font-family: var(--font-pixel);
    font-size: 0.875rem;
    line-height: 1.5;
    white-space: nowrap;
    color: var(--text-dim);
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  a:hover {
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  a.is-active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .home {
    letter-spacing: 0.01em;
    color: var(--text);
  }

  .home:hover {
    color: var(--accent);
    background: none;
  }

  .sep {
    flex-shrink: 0;
    width: 1px;
    height: 16px;
    margin: 0 6px;
    background: var(--line);
  }

  /* En móvil el Blog sale del menú y queda en el pie, para que quepa en una fila. */
  @media (max-width: 40rem) {
    .nav-wrap {
      top: 0.75rem;
    }

    a {
      padding: 6px 7px;
      font-size: 0.75rem;
    }

    .sep {
      margin: 0 2px;
    }

    .blog-only {
      display: none;
    }
  }

  /* Móviles estrechos (360 px): un poco más compacto para que todo quepa. */
  @media (max-width: 24rem) {
    nav {
      padding: 4px;
    }

    a {
      padding: 6px 5px;
      font-size: 0.6875rem;
    }

    .sep {
      display: none;
    }
  }
</style>
