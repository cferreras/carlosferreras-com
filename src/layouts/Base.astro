---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
}

const { title, description, type = 'website', publishedAt } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0f1115" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="generator" content={Astro.generator} />

    <link
      rel="preload"
      href="/fonts/be-vietnam-pro-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Carlos Ferreras" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Carlos Ferreras"
      href={new URL('rss.xml', Astro.site)}
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>

    <Nav />

    <main id="main"><slot /></main>

    <footer class="footer">
      <span>© {year} Carlos Ferreras</span>
    </footer>

    <style>
      /* Una sola columna de lectura, centrada. */
      main {
        flex: 1 0 auto;
        width: 100%;
        max-width: calc(var(--measure) + 2 * var(--gutter));
        margin-inline: auto;
        padding: clamp(3rem, 8vw, 5rem) var(--gutter) 0;
      }

      .footer {
        padding: clamp(3.5rem, 9vw, 5.5rem) var(--gutter) clamp(2rem, 5vw, 3rem);
        text-align: center;
        font-size: 0.875rem;
        color: var(--text-dim);
      }
    </style>
  </body>
</html>
